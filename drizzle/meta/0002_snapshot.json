        "policy_rules_population_required_check": {
          "name": "policy_rules_population_required_check",
          "value": "\"policy_rules\".\"approval_status\" = 'PROHIBITED'\n        or \"policy_rules\".\"approved_for_all\"\n        or cardinality(\"policy_rules\".\"approved_users\") > 0\n        or cardinality(\"policy_rules\".\"approved_departments\") > 0"
        },
        "policy_rules_approved_for_all_check": {
          "name": "policy_rules_approved_for_all_check",
          "value": "not \"policy_rules\".\"approved_for_all\"\n        or (cardinality(\"policy_rules\".\"approved_users\") = 0 and cardinality(\"policy_rules\".\"approved_departments\") = 0)"
        },
        "policy_rules_all_allowed_check": {
          "name": "policy_rules_all_allowed_check",
          "value": "not \"policy_rules\".\"all_permissions_allowed\" or cardinality(\"policy_rules\".\"allowed_permissions\") = 0"
        },
