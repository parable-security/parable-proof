        },
        "policy_rules_all_flags_check": {
          "name": "policy_rules_all_flags_check",
          "value": "not (\"policy_rules\".\"all_permissions_allowed\" and \"policy_rules\".\"all_permissions_prohibited\")"
        },
        "policy_rules_prohibited_shape_check": {
          "name": "policy_rules_prohibited_shape_check",
          "value": "\"policy_rules\".\"approval_status\" <> 'PROHIBITED'\n        or (\"policy_rules\".\"all_permissions_prohibited\"\n          and not \"policy_rules\".\"all_permissions_allowed\"\n          and not \"policy_rules\".\"approved_for_all\"\n          and cardinality(\"policy_rules\".\"approved_users\") = 0\n          and cardinality(\"policy_rules\".\"approved_departments\") = 0\n          and cardinality(\"policy_rules\".\"allowed_permissions\") = 0\n          and cardinality(\"policy_rules\".\"prohibited_permissions\") = 0)"
        },
        "policy_rules_all_prohibited_no_allowed_check": {
          "name": "policy_rules_all_prohibited_no_allowed_check",
          "value": "not \"policy_rules\".\"all_permissions_prohibited\" or cardinality(\"policy_rules\".\"allowed_permissions\") = 0"
        }
      },
